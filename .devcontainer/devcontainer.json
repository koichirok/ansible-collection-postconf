{
	"name": "koichirok.postconf: ansible module for postconf",
	"image": "mcr.microsoft.com/devcontainers/base:noble",
	"features": {
		"ghcr.io/devcontainers-extra/features/ansible:2": {
			"injections": "molecule molecule-plugins[docker] ansible-lint pytest pytest-xdist"
		},
		"ghcr.io/devcontainers/features/docker-in-docker:2": {},
		"ghcr.io/devcontainers-extra/features/black": {}
	},
	"workspaceMount": "source=${localWorkspaceFolder},target=/ansible_collections/koichirok/postconf,type=bind",
	"workspaceFolder": "/ansible_collections/koichirok/postconf",
	"customizations": {
		"vscode": {
			"extensions": [
				"redhat.ansible",
				"ms-python.black-formatter",
				"ms-python.isort"
			],
			"settings": {
				"files.associations": {
					"**/defaults/*.yml": "ansible",
					"**/handlers/*.yml": "ansible",
					"**/meta/*.yml": "ansible",
					"**/molecule/**/*.yml": "ansible",
					"**/tasks/*.yml": "ansible",
					"**/vars/*.yml": "ansible"
				},
				"python.venvPath": "/usr/local/py-utils/venvs",
				"python.defaultInterpreterPath": "/usr/local/py-utils/venvs/ansible-core/bin/python3",
				"python.analysis.extraPaths": ["/"],
				"[python]": {
					"editor.defaultFormatter": "ms-python.black-formatter",
					"editor.formatOnSave": true
				},
				"isort.args": ["--profile", "black"]
			}
		}
	}
}